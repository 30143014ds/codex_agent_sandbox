{
  "name": "codex_agent_sandbox",

  "dockerComposeFile": "../docker-compose.yml",
  "service": "codex_agent_sandbox",
  "workspaceFolder": "/workspace",

  "shutdownAction": "none",
  "remoteUser": "agent",

  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "postCreateCommand": "codex --version",

  "forwardPorts": []
}