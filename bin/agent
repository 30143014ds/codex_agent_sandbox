#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE_COMPOSE="${ROOT_DIR}/compose.yaml"
INSTANCES_DIR="${ROOT_DIR}/instances"
AGENTS_DIR="${ROOT_DIR}/agents"

usage() {
  cat <<'EOF'
Usage:
  ./bin/agent list
  ./bin/agent create <agent-type> <instance> [-e [absolute-workspace-path]]
  ./bin/agent start <instance>
  ./bin/agent attach <instance>
  ./bin/agent shell <instance>
  ./bin/agent logs <instance>
  ./bin/agent stop <instance>
  ./bin/agent down <instance>
  ./bin/agent rename <instance> <new-name>
  ./bin/agent status [instance]

Examples:
  ./bin/agent create developer dev-main -e /srv/projects/my-app
  ./bin/agent create developer dev-scratch -e
  ./bin/agent create cbt cbt-main
  ./bin/agent start dev-main
  ./bin/agent attach cbt-main
EOF
}

fail() {
  echo "Error: $*" >&2
  exit 1
}

require_name() {
  local value="$1"
  local label="$2"
  [[ "${value}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] \
    || fail "${label} must match [a-z0-9][a-z0-9_-]*"
}

absolute_path() {
  local path="$1"
  if [[ "${path}" = /* ]]; then
    printf '%s\n' "${path}"
  else
    printf '%s\n' "$(cd "$(dirname "${path}")" && pwd)/$(basename "${path}")"
  fi
}

read_env_value() {
  local file="$1"
  local key="$2"
  sed -n "s/^${key}=//p" "${file}" | tail -n 1
}

load_instance() {
  local instance="$1"
  require_name "${instance}" "instance"

  INSTANCE_DIR="${INSTANCES_DIR}/${instance}"
  INSTANCE_ENV="${INSTANCE_DIR}/instance.env"
  [[ -f "${INSTANCE_ENV}" ]] || fail "instance '${instance}' does not exist"

  AGENT_TYPE="$(read_env_value "${INSTANCE_ENV}" AGENT_TYPE)"
  [[ -n "${AGENT_TYPE}" ]] || fail "AGENT_TYPE is missing in ${INSTANCE_ENV}"

  [[ -n "$(read_env_value "${INSTANCE_ENV}" INSTANCE_HOME_PATH)" ]] \
    || fail "instance '${instance}' uses the old layout; create a new instance"
  AGENT_INSTANCE="$(read_env_value "${INSTANCE_ENV}" AGENT_INSTANCE)"
  [[ -n "${AGENT_INSTANCE}" ]] || fail "AGENT_INSTANCE is missing in ${INSTANCE_ENV}"
  export AGENT_INSTANCE AGENT_TYPE
  AGENT_OVERRIDE="${INSTANCE_DIR}/compose.override.yaml"

  PROJECT_NAME="$(read_env_value "${INSTANCE_ENV}" COMPOSE_PROJECT_NAME)"
  PROJECT_NAME="${PROJECT_NAME:-codex-${instance}}"
  require_name "${PROJECT_NAME}" "Compose project name"
}

compose_for_instance() {
  local -a args=(docker compose)
  args+=(
    --env-file "${INSTANCE_ENV}"
    --project-name "${PROJECT_NAME}"
    --file "${BASE_COMPOSE}"
  )
  if [[ -f "${AGENT_OVERRIDE}" ]]; then
    args+=(--file "${AGENT_OVERRIDE}")
  fi
  "${args[@]}" "$@"
}

project_name_in_use() {
  local requested="$1" file project instance
  for file in "${INSTANCES_DIR}"/*/instance.env; do
    [[ -f "${file}" ]] || continue
    instance="$(basename "$(dirname "${file}")")"
    project="$(read_env_value "${file}" COMPOSE_PROJECT_NAME)"
    [[ "${project:-codex-${instance}}" != "${requested}" ]] || return 0
  done
  return 1
}

list_all() {
  echo "Agent types:"
  local found=false
  for dir in "${AGENTS_DIR}"/*; do
    [[ -d "${dir}" ]] || continue
    found=true
    printf '  %s\n' "$(basename "${dir}")"
  done
  [[ "${found}" == true ]] || echo "  (none)"

  echo
  echo "Instances:"
  found=false
  for file in "${INSTANCES_DIR}"/*/instance.env; do
    [[ -f "${file}" ]] || continue
    found=true
    local instance type
    instance="$(basename "$(dirname "${file}")")"
    type="$(read_env_value "${file}" AGENT_TYPE)"
    printf '  %-24s %s\n' "${instance}" "${type}"
  done
  [[ "${found}" == true ]] || echo "  (none)"
}

create_instance() {
  local type="${1:-}"
  local instance="${2:-}"

  [[ -n "${type}" && -n "${instance}" ]] || { usage; exit 2; }
  require_name "${type}" "agent type"
  require_name "${instance}" "instance"

  shift 2
  local external_workspace=false
  local requested_workspace=""
  if (( $# > 0 )); then
    [[ "$1" == "-e" ]] || fail "expected -e, got '$1'"
    external_workspace=true
    shift
    if (( $# > 0 )); then
      requested_workspace="$1"
      [[ "${requested_workspace}" = /* ]] \
        || fail "external workspace path must be absolute"
      shift
    fi
  fi
  (( $# == 0 )) || fail "too many arguments for create"

  local type_dir="${AGENTS_DIR}/${type}"
  [[ -d "${type_dir}" ]] || fail "unknown agent type '${type}'"
  [[ ! -e "${INSTANCES_DIR}/${instance}" && ! -L "${INSTANCES_DIR}/${instance}" ]] \
    || fail "instance '${instance}' already exists"

  local instance_dir="${INSTANCES_DIR}/${instance}"
  local instance_home="${instance_dir}/home"
  local project_name="codex-${instance}" suffix=2
  while project_name_in_use "${project_name}"; do
    project_name="codex-${instance}-${suffix}"
    (( suffix += 1 ))
  done
  local workspace_path
  local launcher_owned_workspace=false
  if [[ -n "${requested_workspace}" ]]; then
    mkdir -p "${requested_workspace}"
    workspace_path="$(absolute_path "${requested_workspace}")"
  elif [[ "${external_workspace}" == true ]]; then
    workspace_path="${ROOT_DIR}/workspaces/${instance}"
    launcher_owned_workspace=true
  else
    workspace_path="${instance_dir}/workspace"
    launcher_owned_workspace=true
  fi

  mkdir -p \
    "${instance_home}" \
    "${workspace_path}"
  if [[ -d "${type_dir}/home-template" ]]; then
    cp -a "${type_dir}/home-template/." "${instance_home}/"
  fi
  mkdir -p "${instance_home}/.codex/agents" \
    "${instance_home}/.agents/skills" "${instance_home}/.ssh"
  chmod 700 "${instance_dir}" "${instance_home}" \
    "${instance_home}/.codex" "${instance_home}/.codex/agents" \
    "${instance_home}/.agents" "${instance_home}/.agents/skills" \
    "${instance_home}/.ssh"
  if [[ "${launcher_owned_workspace}" == true ]]; then
    chmod 700 "${workspace_path}"
  fi

  if [[ -f "${type_dir}/compose.override.yaml" ]]; then
    cp -a "${type_dir}/compose.override.yaml" "${instance_dir}/compose.override.yaml"
  fi
  if [[ -d "${type_dir}/workspace-template" ]]; then
    cp -a -n "${type_dir}/workspace-template/." "${workspace_path}/"
  fi

  cat >"${instance_dir}/instance.env" <<EOF
AGENT_TYPE=${type}
AGENT_INSTANCE=${instance}
COMPOSE_PROJECT_NAME=${project_name}
HOST_UID=$(id -u)
HOST_GID=$(id -g)
INSTANCE_HOME_PATH=${instance_home}
WORKSPACE_PATH=${workspace_path}
DEV_BIND_IP=127.0.0.1
DEV_HTTP_PORT=18080
DEV_HTTPS_PORT=18443
DEV_ADMINER_PORT=18081
DEV_APP_PORT=18000
EOF
  chmod 600 "${instance_dir}/instance.env"

  echo "Created '${instance}' from agent type '${type}'."
  echo "Workspace: ${workspace_path}"
  echo "Start:     ./bin/agent start ${instance}"
}

rename_instance() (
  (( $# == 2 )) || { usage; exit 2; }
  local instance="$1" new_name="$2"
  require_name "${new_name}" "new instance name"
  [[ "${instance}" != "${new_name}" ]] || fail "new instance name must differ"
  load_instance "${instance}"

  local new_dir="${INSTANCES_DIR}/${new_name}"
  [[ ! -L "${INSTANCE_DIR}" ]] || fail "cannot rename a symlink instance directory"
  [[ ! -e "${new_dir}" && ! -L "${new_dir}" ]] \
    || fail "instance '${new_name}' already exists"

  local containers
  containers="$(docker ps --all --quiet \
    --filter "label=com.docker.compose.project=${PROJECT_NAME}")"
  [[ -z "${containers}" ]] \
    || fail "run './bin/agent down ${instance}' before rename (stopped containers also count)"

  # Moving an instance directory must not invalidate another instance's mounts.
  local file key value
  for file in "${INSTANCES_DIR}"/*/instance.env; do
    [[ -f "${file}" && "${file}" != "${INSTANCE_ENV}" ]] || continue
    for key in INSTANCE_HOME_PATH WORKSPACE_PATH; do
      value="$(read_env_value "${file}" "${key}")"
      if [[ "${value}" == "${INSTANCE_DIR}" || "${value}" == "${INSTANCE_DIR}/"* ]]; then
        fail "${key} in ${file} refers to this instance; update that path and recreate its container before rename"
      fi
    done
  done

  local rename_temp line project_written=false
  rename_temp="$(mktemp "${INSTANCES_DIR}/.rename.XXXXXX")"
  trap 'rm -f -- "${rename_temp}"' EXIT
  while IFS= read -r line || [[ -n "${line}" ]]; do
    case "${line}" in
      AGENT_INSTANCE=*)
        line="AGENT_INSTANCE=${new_name}"
        ;;
      COMPOSE_PROJECT_NAME=*)
        line="COMPOSE_PROJECT_NAME=${PROJECT_NAME}"
        project_written=true
        ;;
      INSTANCE_HOME_PATH=*|WORKSPACE_PATH=*)
        key="${line%%=*}"
        value="${line#*=}"
        if [[ "${value}" == "${INSTANCE_DIR}" || "${value}" == "${INSTANCE_DIR}/"* ]]; then
          line="${key}=${new_dir}${value#"${INSTANCE_DIR}"}"
        fi
        ;;
    esac
    printf '%s\n' "${line}"
  done <"${INSTANCE_ENV}" >"${rename_temp}"
  if [[ "${project_written}" == false ]]; then
    printf 'COMPOSE_PROJECT_NAME=%s\n' "${PROJECT_NAME}" >>"${rename_temp}"
  fi

  mv -T -- "${INSTANCE_DIR}" "${new_dir}"
  if ! mv -f -- "${rename_temp}" "${new_dir}/instance.env"; then
    mv -T -- "${new_dir}" "${INSTANCE_DIR}" \
      || fail "could not restore instance directory after failed rename"
    fail "could not update instance.env; original instance restored"
  fi

  echo "Renamed '${instance}' to '${new_name}'."
  echo "Docker project retained: ${PROJECT_NAME}"
  echo "Start: ./bin/agent start ${new_name}"
)

status_all() {
  local found=false
  for file in "${INSTANCES_DIR}"/*/instance.env; do
    [[ -f "${file}" ]] || continue
    found=true
    local instance
    instance="$(basename "$(dirname "${file}")")"
    load_instance "${instance}"
    echo "== ${instance} (${AGENT_TYPE}) =="
    compose_for_instance ps
  done
  [[ "${found}" == true ]] || echo "No instances."
}

main() {
  local command="${1:-}"
  case "${command}" in
    list)
      list_all
      ;;
    create)
      create_instance "${@:2}"
      ;;
    rename)
      rename_instance "${@:2}"
      ;;
    start)
      load_instance "${2:-}"
      local container_id
      container_id="$(compose_for_instance ps --all --quiet agent)"
      if [[ -n "${container_id}" ]]; then
        compose_for_instance start --wait --wait-timeout 90
      else
      compose_for_instance up -d --build --wait --wait-timeout 90
      fi
      ;;
    attach)
      load_instance "${2:-}"
      compose_for_instance exec agent codex
      ;;
    shell)
      load_instance "${2:-}"
      compose_for_instance exec agent bash
      ;;
    logs)
      load_instance "${2:-}"
      compose_for_instance logs --follow
      ;;
    stop)
      load_instance "${2:-}"
      compose_for_instance stop
      ;;
    down)
      load_instance "${2:-}"
      compose_for_instance down
      ;;
    status)
      if [[ -n "${2:-}" ]]; then
        load_instance "$2"
        compose_for_instance ps
      else
        status_all
      fi
      ;;
    help|-h|--help|"")
      usage
      ;;
    *)
      fail "unknown command '${command}'"
      ;;
  esac
}

main "$@"
