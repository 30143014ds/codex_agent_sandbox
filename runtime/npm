#!/usr/bin/env bash
set -euo pipefail

# Give the CLI's update command its own writable installation prefix.
# Other npm commands keep npm's normal configuration and system permissions.
if [[ "${EUID}" != 0 && "$#" == 3 && "$1" == install \
  && ( "$2" == -g || "$2" == --global ) \
  && ( "$3" == @openai/codex || "$3" == @openai/codex@latest ) ]]; then
  exec /usr/local/bin/node /usr/local/lib/node_modules/npm/bin/npm-cli.js \
    install --global --prefix "${HOME}/.local/share/codex" "$3"
fi

exec /usr/local/bin/node /usr/local/lib/node_modules/npm/bin/npm-cli.js "$@"
